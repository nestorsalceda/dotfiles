font-family = "JetBrains Mono"
font-style = "Regular"
font-size = 15
theme = "light:Catppuccin Macchiato, dark:Catppuccin Mocha"
gtk-titlebar = false
unfocused-split-opacity = 0.9
background-opacity = 0.99
app-notifications = no-clipboard-copy
window-theme = ghostty

keybind=ctrl+super+alt+arrow_down=goto_split:down
keybind=ctrl+super+alt+arrow_left=goto_split:left
keybind=ctrl+super+alt+arrow_right=goto_split:right
keybind=ctrl+super+alt+arrow_up=goto_split:up
keybind=ctrl+super+alt+==equalize_splits
